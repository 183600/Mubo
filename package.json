{
  "name": "mubo",
  "version": "0.1.0",
  "description": "Bun-first hyper-monolith framework: HTTP, SQLite migrations, WebSocket, static assets and single-file builds.",
  "type": "module",
  "bin": {
    "mubo": "./src/cli/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "PLAN.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/cli/index.ts dev",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "keywords": [
    "bun",
    "framework",
    "sqlite",
    "websocket",
    "monolith"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
